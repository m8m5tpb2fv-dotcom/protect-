# ───────── App ─────────
NEXT_PUBLIC_APP_NAME="Рядом"
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=saratov
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# One-click demo accounts + visible "Demo" labels. MUST be false in production.
DEMO_MODE=true

# ───────── Database (PostgreSQL 14+) ─────────
DATABASE_URL=postgres://ryadom:ryadom@localhost:5432/ryadom

# ───────── Security ─────────
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# ───────── Admin bootstrap (used by `npm run db:seed` / `npm run admin:create`) ─────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ───────── Telegram ─────────
# Only the token is required: webhook, menu button and commands are configured on start (scripts/telegram-setup.ts).
TELEGRAM_BOT_TOKEN=
# Optional overrides: webhook secret (default: HMAC of SESSION_SECRET + token), bot username (default: getMe)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Short name of a Mini App from @BotFather /newapp → direct links t.me/<bot>/<app>. Empty = links go via the bot chat.
TELEGRAM_APP_NAME=

# ───────── Storage ─────────
# local = ./storage on disk (dev / single VPS); s3 = any S3-compatible (Yandex Object Storage, Selectel, MinIO, AWS)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket / CDN, e.g. https://cdn.example.com
S3_PUBLIC_URL=

# ───────── Maps ─────────
# leaflet (OpenStreetMap tiles, no key) | yandex | 2gis
NEXT_PUBLIC_MAP_PROVIDER=leaflet
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_2GIS_API_KEY=

# ───────── Monetisation (optional, docs/MONETIZATION.md) ─────────
# Zero commission: clients pay providers directly, no money passes through the platform.
# Optional paid channels, comma-separated: pro, promotion, ads. Empty = everything free, no paid offers anywhere.
# Paid services are requested by providers and activated by an admin after an invoice is paid off-platform (no acquiring).
MONETIZATION_CHANNELS=

# ───────── SMS / Email ─────────
# console = codes are printed to server log (and shown in UI while DEMO_MODE=true)
SMS_PROVIDER=console
SMSRU_API_KEY=
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Рядом <no-reply@example.com>"
