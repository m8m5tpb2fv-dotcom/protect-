# ───────── App ─────────
NEXT_PUBLIC_APP_NAME="Рядом"
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=saratov
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Platform commission on completed orders (0..1)
COMMISSION_RATE=0.08
# One-click demo accounts + visible "Demo" labels. MUST be false in production.
DEMO_MODE=true

# ───────── Database (PostgreSQL 14+) ─────────
DATABASE_URL=postgres://ryadom:ryadom@localhost:5432/ryadom

# ───────── Security ─────────
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# ───────── Admin bootstrap (used by `npm run db:seed` / `npm run admin:create`) ─────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ───────── Telegram ─────────
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Short name of the Mini App created in @BotFather (/newapp) → t.me/<bot>/<app>
NEXT_PUBLIC_TELEGRAM_APP_NAME=app

# ───────── Storage ─────────
# local = ./storage on disk (dev / single VPS); s3 = any S3-compatible (Yandex Object Storage, Selectel, MinIO, AWS)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket / CDN, e.g. https://cdn.example.com
S3_PUBLIC_URL=

# ───────── Maps ─────────
# leaflet (OpenStreetMap/CARTO tiles, no key) | yandex | 2gis
NEXT_PUBLIC_MAP_PROVIDER=leaflet
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_2GIS_API_KEY=

# ───────── Payments ─────────
# sandbox = test gateway inside the app (clearly labelled TEST); yookassa = real payments
PAYMENT_GATEWAY=sandbox
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ───────── SMS / Email ─────────
# console = codes are printed to server log (and shown in UI while DEMO_MODE=true)
SMS_PROVIDER=console
SMSRU_API_KEY=
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Рядом <no-reply@example.com>"
